# Copy this file to server/.env and fill in the values.
# server/.env is git-ignored — never commit real secrets.

PORT=5000

# Local Postgres (used when DATABASE_URL is not set)
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=connectnext

# Production only — overrides the DB_* vars above
# DATABASE_URL=postgres://user:pass@host:5432/connectnext

CLIENT_URL=http://localhost:5173
SESSION_SECRET=change-me-to-a-long-random-string
NODE_ENV=development

# AI features — Groq (OpenAI-compatible). Free key: https://console.groq.com/keys
# Leave blank to run the app with AI turned off.
GROQ_API_KEY=
AI_MODEL=openai/gpt-oss-120b

# Email (password reset links) — Resend. Key: https://resend.com/api-keys
# Leave blank in local dev: the reset link is then returned by the API / shown
# in the UI instead of emailed.
# MAIL_FROM must use a domain verified in Resend. Until you verify one, use
# "onboarding@resend.dev" (only delivers to your own Resend account email).
RESEND_API_KEY=
MAIL_FROM="ConnectNext <onboarding@resend.dev>"
