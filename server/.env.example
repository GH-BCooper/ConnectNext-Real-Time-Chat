# Copy this file to server/.env and fill in the values.
# server/.env is git-ignored — never commit real secrets.

PORT=5000

# Local Postgres (used when DATABASE_URL is not set)
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=connectnext

# Production only — overrides the DB_* vars above
# DATABASE_URL=postgres://user:pass@host:5432/connectnext

CLIENT_URL=http://localhost:5173
SESSION_SECRET=change-me-to-a-long-random-string
NODE_ENV=development

# AI features — Groq (OpenAI-compatible). Free key: https://console.groq.com/keys
# Leave blank to run the app with AI turned off.
GROQ_API_KEY=
AI_MODEL=openai/gpt-oss-120b
